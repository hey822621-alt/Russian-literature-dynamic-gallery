    .detail-wrap{max-width:1250px;margin:55px auto 0;padding:0 32px 100px}.author-panel{display:none;animation:slideIn .65s both}.author-panel.active{display:block}@keyframes slideIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}.panel-head{display:grid;grid-template-columns:1.2fr 1fr;gap:8vw;align-items:end;padding:40px 0 42px;border-top:1px solid var(--line)}.num{font:italic 90px/.75 'Cormorant Garamond',Georgia,serif;color:var(--accent);opacity:.85}.author-title{font-weight:500;font-size:clamp(29px,3vw,49px);line-height:1.45;margin:12px 0 4px}.ru-name{font:italic clamp(22px,2.4vw,36px) 'Cormorant Garamond',Georgia,serif;margin:0 0 20px}.years{font:12px Arial,sans-serif;letter-spacing:2px;color:var(--muted)}.panel-lede{font-size:15px;line-height:2.5;margin:12px 0 15px}.theory{font-size:13px;line-height:2.2;color:var(--muted);font-style:italic;margin:0;overflow-wrap:anywhere}.section-marker{display:flex;justify-content:space-between;gap:15px;align-items:center;padding:15px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:24px}.section-marker span:last-child{color:var(--muted)}
    .concept{padding:25px 0 35px;max-width:990px}.concept .zh{font-size:clamp(22px,2.8vw,39px);font-weight:400;margin:10px 0 5px}.concept .ru{font-size:clamp(16px,1.7vw,24px);color:var(--accent);margin:0;line-height:1.7}.work-row{display:grid;grid-template-columns:minmax(210px,1fr) minmax(190px,.9fr) minmax(250px,1.1fr);gap:clamp(22px,3vw,48px);border-top:1px solid var(--line);padding:38px 0}.work-art{margin:0;min-width:0;align-self:start}.work-art img{display:block;width:100%;height:auto;aspect-ratio:5/3;object-fit:cover;border:1px solid var(--line);filter:saturate(.9);transition:filter .4s,transform .4s}.work-art img:hover{filter:saturate(1.13)}.work-art figcaption{display:flex;justify-content:space-between;gap:8px;font-size:11px;color:var(--muted);padding-top:10px}.work-count{font:11px Arial,sans-serif;letter-spacing:2px;color:var(--accent)}.work-title{font-size:clamp(23px,2.6vw,37px);font-weight:500;margin:12px 0 3px}.work-ru{font-size:17px;font-style:italic;margin:0;color:var(--muted);line-height:1.7}.work-label{font-size:12px;margin:17px 0 3px;color:var(--muted)}.work-idea{font-size:17px;margin:0}.work-idea-ru{display:block;color:var(--accent);font-size:16px;margin-top:6px;line-height:1.7}.work-desc{font-size:14px;line-height:2.2;margin:0 0 15px}.work-quote{font-size:14px;line-height:2.25;margin:0;color:var(--muted);overflow-wrap:anywhere;border-left:2px solid var(--accent);padding-left:22px}.scene-band{position:relative;overflow:hidden;max-height:420px;margin-top:30px}.scene-band img{width:100%;height:360px;object-fit:cover;display:block;filter:saturate(.87)}.scene-band span{position:absolute;left:24px;bottom:24px;background:#f3eadacb;color:#302b28;font:11px Arial,sans-serif;letter-spacing:2px;padding:11px 15px}.site-footer{border-top:1px solid var(--line);max-width:1250px;padding:30px 32px 55px;margin:auto;display:flex;justify-content:space-between;gap:20px;color:var(--muted);font-size:12px;line-height:1.9}.closing{font:italic 26px 'Times New Roman',serif;color:var(--ink);margin:0}
    @media(max-width:950px){.work-row{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.work-row>div:last-child{grid-column:2}.work-art{grid-row:1 / span 2;align-self:start}}@media(max-width:700px){.site-header{padding:20px}.nav{gap:12px;font-size:10px;letter-spacing:0}.nav a:nth-child(2){display:none}.language{display:none}.brand{font-size:25px}.hero-intro{padding-top:25px}.hero-intro h1{font-size:35px}.theater{min-height:390px}.carousel{height:365px}.art-card{width:235px;height:335px;top:10px;transform:translateX(-50%) translateX(calc(var(--offset) * 64%)) translateZ(calc(var(--abs) * -180px)) rotateY(calc(var(--offset) * -34deg)) scale(calc(1 - var(--abs) * .12))}.card-title{left:16px;bottom:17px}.card-title strong{font-size:20px}.carousel-control{margin:0 0 20px}.detail-wrap{margin:10px auto 0;padding:0 23px 55px}.panel-head{grid-template-columns:1fr;gap:25px;padding:25px 0}.num{font-size:68px}.panel-lede{line-height:2.1}.work-row{grid-template-columns:1fr;gap:18px;padding:26px 0}.work-row>div:last-child{grid-column:auto}.work-art{grid-row:auto}.work-quote{padding-left:12px}.scene-band img{height:235px}.site-footer{padding:25px 22px 50px;flex-direction:column}.section-marker{font-size:11px}.theory{font-size:12px}}@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation-duration:.01ms!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}

    [lang="ru"],.ru-name,.work-ru,.ru-sub,.work-idea-ru,.brand small{font-family:'Times New Roman',Times,serif!important}
    .art-card img{animation:galleryBreathe 15s ease-in-out infinite alternate;transform-origin:50% 52%}
    .art-card:not([aria-current="true"]) img{animation-play-state:paused}
    @keyframes galleryBreathe{from{transform:scale(1)}to{transform:scale(1.055) translateY(-.5%)}}
    .author-panel.active{animation:galleryEnter .75s cubic-bezier(.16,1,.3,1) both}
    @keyframes galleryEnter{from{opacity:0;transform:translateY(17px)}to{opacity:1;transform:translateY(0)}}
    .narrative-gallery{margin:5px 0 50px;border-top:1px solid var(--line);padding-top:27px}
    .narrative-topline{display:flex;justify-content:space-between;align-items:center;gap:12px;font-size:12px;color:var(--muted);margin-bottom:20px;letter-spacing:.08em}
    .narrative-stage{position:relative;overflow:hidden;background:#201d1a;aspect-ratio:16/8.2;max-height:510px}
    .narrative-stage img{width:100%;height:100%;object-fit:cover;display:block;animation:sceneDrift 13s ease-in-out infinite alternate;filter:saturate(.89)}
    .narrative-stage::before{content:'';position:absolute;z-index:1;inset:0;pointer-events:none;background:linear-gradient(180deg,transparent 48%,rgba(0,0,0,.65))}
    .narrative-stage::after{content:'';position:absolute;z-index:1;inset:-25%;pointer-events:none;background:linear-gradient(115deg,transparent 38%,rgba(255,228,175,.065) 52%,transparent 65%);animation:lightShift 16s ease-in-out infinite alternate}
    @keyframes sceneDrift{from{transform:scale(1.01) translateX(-.5%)}to{transform:scale(1.065) translateX(.5%)}}
    @keyframes lightShift{from{transform:translateX(-10%)}to{transform:translateX(10%)}}
    .narrative-stage img.refresh{animation:paintingReveal .8s cubic-bezier(.2,.8,.2,1) both,sceneDrift 13s ease-in-out .8s infinite alternate}
    @keyframes paintingReveal{from{opacity:.25;filter:blur(9px) saturate(.65);transform:scale(1.035)}to{opacity:1;filter:blur(0) saturate(.89);transform:scale(1.01)}}
    .narrative-caption{position:absolute;left:clamp(16px,3vw,32px);bottom:24px;right:120px;z-index:2;color:#fff6e9;text-shadow:0 2px 10px #0007}
    .narrative-caption h4{font-size:clamp(17px,2.3vw,28px);font-weight:500;margin:4px 0}.narrative-caption p{font-family:'Times New Roman',Times,serif;font-size:clamp(14px,1.5vw,18px);margin:0}
    .narrative-arrows{position:absolute;z-index:3;right:20px;bottom:25px;display:flex;gap:8px}
    .narrative-arrows button{width:38px;height:38px;border:1px solid #fff9;color:white;border-radius:50%;background:#251f1d68;cursor:pointer;transition:background .3s,transform .3s}.narrative-arrows button:hover{background:#251f1dd9;transform:scale(1.05)}
    .narrative-thumbs{display:grid;grid-template-columns:repeat(var(--count),minmax(0,1fr));gap:12px;margin-top:15px}
    .narrative-thumb{padding:0;border:1px solid transparent;background:transparent;color:inherit;text-align:left;cursor:pointer;min-width:0;opacity:.68;transition:opacity .45s,border-color .45s,transform .45s}
    .narrative-thumb:hover,.narrative-thumb.is-selected{opacity:1}.narrative-thumb.is-selected{border-color:var(--accent);transform:translateY(-4px)}
    .narrative-thumb img{width:100%;aspect-ratio:1.5;object-fit:cover;display:block}.narrative-thumb span{font-size:clamp(11px,1vw,13px);display:block;line-height:1.65;padding:8px 7px 0}.narrative-thumb small{font-family:'Times New Roman',Times,serif;color:var(--muted);display:block;line-height:1.5;padding:1px 7px 9px;font-size:11px}
    .narrative-note{font-size:11px;color:var(--muted);line-height:1.8;margin:13px 0 0}
    @media(max-width:700px){.narrative-stage{aspect-ratio:4/3}.narrative-thumbs{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:10px;padding-bottom:10px}.narrative-thumb{min-width:155px;width:155px;scroll-snap-align:center}.narrative-caption{right:90px}.narrative-arrows{right:12px;bottom:16px}.narrative-arrows button{width:32px;height:32px}.narrative-caption{bottom:15px}.brand{font-size:20px}}
    @media(prefers-reduced-motion:reduce){.art-card img,.narrative-stage img,.narrative-stage::after{animation:none!important}.narrative-thumb{transform:none!important}}
  
    body::before{content:'';position:fixed;inset:-10%;pointer-events:none;z-index:1;opacity:.24;background:radial-gradient(circle at 20% 10%, color-mix(in srgb,var(--accent) 18%, transparent), transparent 36%),radial-gradient(circle at 82% 24%, color-mix(in srgb,var(--accent) 12%, transparent), transparent 32%),radial-gradient(circle at 50% 90%, color-mix(in srgb,var(--line) 25%, transparent), transparent 42%);animation:ambientFlow 22s ease-in-out infinite alternate}
    @keyframes ambientFlow{from{transform:translate3d(0,0,0) scale(1)}to{transform:translate3d(0,-1.2%,0) scale(1.04)}}
    .site-header,.hero-intro,.theater,.detail-wrap,.site-footer{position:relative;z-index:2}
    .hero-intro h1,.hero-intro p,.hero-intro .eyebrow{animation:softReveal .9s both}
    .hero-intro p{animation-delay:.12s}.hero-intro .ru-sub{animation-delay:.18s}
    @keyframes softReveal{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}
    .theater{scroll-margin-top:30px}
    .carousel{mask-image:linear-gradient(90deg,transparent,black 8%,black 92%,transparent)}
    .art-card[aria-current="true"]{animation:cardFloat 8s ease-in-out infinite alternate}
    @keyframes cardFloat{from{transform:translateX(-50%) translateX(calc(var(--offset) * 82%)) translateZ(calc(var(--abs) * -130px)) rotateY(calc(var(--offset) * -30deg)) scale(calc(1 - var(--abs) * .06)) translateY(0)}to{transform:translateX(-50%) translateX(calc(var(--offset) * 82%)) translateZ(calc(var(--abs) * -130px)) rotateY(calc(var(--offset) * -30deg)) scale(calc(1 - var(--abs) * .06)) translateY(-6px)}}
    .work-art img{animation:artFloat 15s ease-in-out infinite alternate;transform-origin:50% 50%}
    .scene-band{border:1px solid var(--line)}
    .scene-band img{animation:panSlow 20s ease-in-out infinite alternate;transform-origin:50% 50%}
    @keyframes panSlow{from{transform:scale(1.02) translateX(0)}to{transform:scale(1.08) translateX(-1.5%)}}
    .narrative-gallery{position:relative}
    .narrative-stage{border:1px solid var(--line);box-shadow:0 20px 60px color-mix(in srgb,var(--ink) 12%, transparent)}
    .narrative-stage::before{content:'';position:absolute;inset:-10%;z-index:1;pointer-events:none;background:linear-gradient(115deg,transparent 20%,rgba(255,248,233,.08) 37%,rgba(255,236,190,.2) 48%,rgba(255,248,233,.08) 61%,transparent 78%);transform:translateX(-22%) rotate(2deg);animation:lightSweep 18s ease-in-out infinite}
    .narrative-stage::after{content:'';position:absolute;inset:0;z-index:1;pointer-events:none;background:radial-gradient(circle at 75% 20%, rgba(255,255,255,.18), transparent 22%),linear-gradient(to top, rgba(18,12,9,.34), transparent 40%);mix-blend-mode:screen;opacity:.75}
    @keyframes lightSweep{0%,100%{transform:translateX(-24%) rotate(2deg)}50%{transform:translateX(18%) rotate(2deg)}}
    .narrative-image{position:relative;z-index:0;animation:sceneDrift 18s ease-in-out infinite alternate;transform-origin:50% 50%;will-change:transform,filter}
    @keyframes sceneDrift{from{transform:scale(1) translate3d(0,0,0);filter:saturate(.96) brightness(.98)}to{transform:scale(1.06) translate3d(-1%,-.6%,0);filter:saturate(1.06) brightness(1.02)}}
    .narrative-image.refresh{animation:storySwap .55s cubic-bezier(.2,.8,.2,1),sceneDrift 18s .56s ease-in-out infinite alternate}
    @keyframes storySwap{from{opacity:.15;transform:scale(1.035);filter:blur(6px) brightness(1.04)}to{opacity:1;transform:scale(1);filter:blur(0) brightness(1)}}
    .narrative-caption{backdrop-filter:blur(8px);background:linear-gradient(180deg,rgba(20,14,10,.02),rgba(20,14,10,.35));}
    .narrative-thumbs{scroll-behavior:smooth}
    .narrative-thumb{transition:transform .35s ease,opacity .35s ease,border-color .35s ease,box-shadow .35s ease}
    .narrative-thumb:hover,.narrative-thumb.is-selected{transform:translateY(-3px);box-shadow:0 12px 30px color-mix(in srgb,var(--ink) 14%, transparent)}
    .narrative-thumb img{transition:transform .5s ease,filter .5s ease}
    .narrative-thumb:hover img,.narrative-thumb.is-selected img{transform:scale(1.05);filter:saturate(1.05)}
    .narrative-gallery[data-auto="on"] .story-progress::after{content:' · 自动播放';opacity:.72}
    .author-panel{scroll-margin-top:44px}
    @media(max-width:700px){.narrative-stage{aspect-ratio:4/3;max-height:none}.narrative-stage::before{animation-duration:14s}.art-card[aria-current="true"]{animation:none}.work-art img,.scene-band img,.narrative-image{animation-duration:12s}}
    @media(prefers-reduced-motion:reduce){body::before,.hero-intro h1,.hero-intro p,.hero-intro .eyebrow,.art-card[aria-current="true"],.work-art img,.scene-band img,.narrative-image,.narrative-stage::before{animation:none!important}.narrative-thumbs{scroll-behavior:auto}}

  
    .effect-layer{position:absolute;inset:-8%;pointer-events:none;z-index:1;opacity:0;transition:opacity .6s ease;overflow:hidden}
    .effect-layer::before,.effect-layer::after{content:'';position:absolute;inset:-20%;pointer-events:none}
    .narrative-stage[data-effect]{--fx-opacity:1}
    .narrative-stage[data-effect~="glow"] .effect-a{opacity:.82}
    .narrative-stage[data-effect~="glow"] .effect-a::before{background:radial-gradient(circle at 22% 24%, rgba(255,221,167,.28), transparent 19%),radial-gradient(circle at 78% 18%, rgba(255,215,145,.18), transparent 17%),linear-gradient(to top, rgba(255,205,120,.08), transparent 40%);animation:flickerGlow 3.4s ease-in-out infinite alternate}
    .narrative-stage[data-effect~="sparkle"] .effect-b{opacity:.7}
    .narrative-stage[data-effect~="sparkle"] .effect-b::before{background-image:radial-gradient(circle, rgba(255,245,220,.9) 0 1px, transparent 1.4px);background-size:95px 95px;animation:sparkleMove 12s linear infinite}
    .narrative-stage[data-effect~="snow"] .effect-a{opacity:.88}
    .narrative-stage[data-effect~="snow"] .effect-a::before,.narrative-stage[data-effect~="snow"] .effect-a::after{background-image:radial-gradient(circle, rgba(255,255,255,.95) 0 1px, transparent 1.7px),radial-gradient(circle, rgba(255,255,255,.85) 0 1.6px, transparent 2.2px),radial-gradient(circle, rgba(255,255,255,.75) 0 2px, transparent 2.7px);background-size:120px 120px,180px 180px,240px 240px;background-position:0 0,40px 40px,90px 20px;animation:snowFall 15s linear infinite}
    .narrative-stage[data-effect~="snow"] .effect-a::after{animation-duration:22s;opacity:.7;filter:blur(.4px)}
    .narrative-stage[data-effect~="petals"] .effect-a{opacity:.85}
    .narrative-stage[data-effect~="petals"] .effect-a::before,.narrative-stage[data-effect~="petals"] .effect-a::after{background-image:radial-gradient(ellipse at center, rgba(255,219,229,.96) 0 45%, rgba(255,173,201,.9) 46% 60%, transparent 61%);background-size:26px 18px;background-repeat:repeat;animation:petalFall 18s linear infinite;transform:rotate(-8deg)}
    .narrative-stage[data-effect~="petals"] .effect-a::after{animation-duration:26s;opacity:.6;filter:blur(.35px);transform:rotate(8deg)}
    .narrative-stage[data-effect~="fog"] .effect-b{opacity:.65;mix-blend-mode:screen}
    .narrative-stage[data-effect~="fog"] .effect-b::before{background:radial-gradient(circle at 12% 72%, rgba(235,238,244,.42), transparent 18%),radial-gradient(circle at 44% 78%, rgba(235,238,244,.4), transparent 23%),radial-gradient(circle at 80% 66%, rgba(235,238,244,.35), transparent 20%);filter:blur(10px);animation:fogDrift 17s ease-in-out infinite alternate}
    .narrative-stage[data-effect~="smoke"] .effect-b{opacity:.72}
    .narrative-stage[data-effect~="smoke"] .effect-b::after{background:radial-gradient(circle at 18% 70%, rgba(82,68,59,.22), transparent 18%),radial-gradient(circle at 54% 76%, rgba(70,57,51,.28), transparent 22%),radial-gradient(circle at 78% 58%, rgba(105,86,70,.18), transparent 20%);filter:blur(14px);animation:smokeLift 14s ease-in-out infinite alternate}
    .narrative-stage[data-effect~="embers"] .effect-a{opacity:.95}
    .narrative-stage[data-effect~="embers"] .effect-a::after{background-image:radial-gradient(circle, rgba(255,194,107,.95) 0 1.4px, transparent 1.8px),radial-gradient(circle, rgba(255,120,69,.88) 0 2.2px, transparent 2.8px);background-size:130px 130px,210px 210px;animation:embersRise 13s linear infinite}
    .narrative-stage[data-effect~="water"] .effect-b{opacity:.4;mix-blend-mode:screen}
    .narrative-stage[data-effect~="water"] .effect-b::before{inset:auto -10% 0 -10%;height:45%;background:repeating-linear-gradient(175deg, rgba(255,255,255,.18) 0 2px, rgba(255,255,255,0) 3px 13px),linear-gradient(to top, rgba(130,171,211,.14), transparent 40%);animation:waterShimmer 6s ease-in-out infinite}
    .narrative-stage[data-effect~="rain"] .effect-a{opacity:.5}
    .narrative-stage[data-effect~="rain"] .effect-a::before{background:repeating-linear-gradient(104deg, rgba(218,226,236,.0) 0 16px, rgba(218,226,236,.35) 16px 18px, rgba(218,226,236,.0) 18px 34px);animation:rainSweep 1.4s linear infinite}
    @keyframes flickerGlow{0%{opacity:.75;transform:scale(1)}50%{opacity:.95;transform:scale(1.015)}100%{opacity:.82;transform:scale(1.03)}}
    @keyframes sparkleMove{from{transform:translate3d(0,0,0)}to{transform:translate3d(-3%,4%,0)}}
    @keyframes snowFall{from{transform:translate3d(0,-8%,0)}to{transform:translate3d(-2%,16%,0)}}
    @keyframes petalFall{from{transform:translate3d(0,-10%,0) rotate(-8deg)}to{transform:translate3d(3%,18%,0) rotate(14deg)}}
    @keyframes fogDrift{from{transform:translate3d(-2%,0,0)}to{transform:translate3d(3%,-2%,0)}}
    @keyframes smokeLift{from{transform:translate3d(0,6%,0) scale(1)}to{transform:translate3d(2%,-6%,0) scale(1.06)}}
    @keyframes embersRise{from{transform:translate3d(0,10%,0)}to{transform:translate3d(1%,-12%,0)}}
    @keyframes waterShimmer{0%,100%{transform:translateX(0) scaleY(1)}50%{transform:translateX(-1.5%) scaleY(1.03)}}
    @keyframes rainSweep{from{transform:translateY(-4%)}to{transform:translateY(8%)}}
    @media(prefers-reduced-motion:reduce){.effect-layer,.effect-layer::before,.effect-layer::after{animation:none!important;display:none!important}}

  </style>
</head>
<body>
  <header class="site-header" id="top">
    <a href="#top" class="brand" aria-label="俄罗斯文学流动画廊，回到首页">俄罗斯文学的流动画廊<small>Галерея русской литературы</small></a>
    <nav class="nav" aria-label="网站导航"><a href="#authors">作家</a><a href="#details">文学概念</a><a href="#details">作品</a><a href="#about">关于</a></nav>
    <span class="language" aria-label="中文及俄语">中 / РУ</span>
  </header>
  <main>
    <section class="hero-intro" aria-labelledby="title">
      <div class="eyebrow">文字与风景 · Слово и пейзаж</div>
      <h1 id="title">俄罗斯文学的流动画廊</h1>
      <p>五位作家，五种光线。在绘画与文学之间，遇见俄罗斯文学的灵魂。</p>
      <p class="ru-sub" lang="ru">Пять писателей. Пять оттенков света. Одно путешествие по русской литературе.</p>
    </section>
    <section class="theater" id="authors" aria-label="按出生年份排列的作家画廊">
      <div class="carousel" id="carousel">
        {authors.map((author,i)=><button type="button" class="art-card" data-index={i} aria-label={`查看${author.name}，${author.years}`} aria-current={i===0?'true':'false'} style={`--offset:${i};--abs:${i};--visibility:${i>2?0:1}`}><img src={author.image} alt={`${author.name}代表作品的后印象派风格画面`} loading={i===0?'eager':'lazy'}/><span class="card-title"><small>{author.number} / {author.years}</small><strong>{author.name}</strong><em lang="ru">{author.ru}</em></span></button>)}
      </div>
      <div class="carousel-control"><button class="arrow" id="prev" type="button" aria-label="上一位作家">←</button><div class="current-counter" aria-live="polite"><span id="current-index">01</span> / 05</div><button class="arrow" id="next" type="button" aria-label="下一位作家">→</button></div>
      <div class="progress" aria-label="选择作家">{authors.map((author,i)=><button type="button" class:list={['dot',{active:i===0}]} data-go={i} aria-label={`切换到${author.name}`}></button>)}</div>
    </section>
    <section class="detail-wrap" id="details" aria-label="作家作品与文学概念">
      {authors.map((author,i)=><article class:list={['author-panel',{active:i===0}]} data-panel={i} id={author.slug} aria-hidden={i===0?'false':'true'}>
        <div class="panel-head"><div><div class="num">{author.number}</div><h2 class="author-title">{author.name}</h2><p class="ru-name" lang="ru">{author.ru}</p><p class="years">{author.years} / {author.era}</p></div><div><div class="eyebrow">文学世界 · Литературный мир</div><p class="panel-lede">{author.intro}</p><p class="theory" lang="ru">{author.theory}</p></div></div>
        <div class="section-marker"><span class="eyebrow">核心文学概念 · Ключевая литературная идея</span><span class="eyebrow">{author.number} / 05</span></div>
        <div class="concept"><h3 class="zh">{author.concept}</h3><p class="ru" lang="ru">{author.conceptRu}</p></div>
        <div class="section-marker"><span class="eyebrow">代表作品 · Основные произведения</span><span class="eyebrow">{String(author.works.length).padStart(2,'0')} 篇 / 部</span></div>
        {author.works.map((work,j)=><div class="work-chapter"><div class="work-row"><figure class="work-art"><img src={work.art} alt={work.artAlt} loading="lazy" decoding="async" width="1200" height="720"/><figcaption>绘画场景 · Живописная сцена <span>{String(j+1).padStart(2,'0')}</span></figcaption></figure><div><span class="work-count">作品 {String(j+1).padStart(2,'0')}</span><h3 class="work-title">《{work.title}》</h3><p class="work-ru" lang="ru">«{work.ru}»</p><p class="work-label">核心概念 · Основная идея</p><p class="work-idea">{work.idea}<span class="work-idea-ru" lang="ru">{work.ideaRu}</span></p></div><div><p class="work-desc">{work.desc}</p>{work.quote&&<blockquote class="work-quote" lang="ru">{work.quote}</blockquote>}</div></div>
        <section class="narrative-gallery" aria-label={`《${work.title}》主要情节画廊`} data-story={work.title}>
          <div class="narrative-topline"><span>情节绘画 · Сюжеты в живописи</span><span class="story-progress" aria-live="polite">01 / {String(storyboards[work.title]?.length || 1).padStart(2,'0')}</span></div>
          <div class="narrative-stage">
            <img class="narrative-image" src={storyboards[work.title]?.[0]?.image || work.art} alt={storyboards[work.title]?.[0]?.title || work.artAlt} loading="lazy" decoding="async" width="1000" height="650" />
            <div class="effect-layer effect-a" aria-hidden="true"></div><div class="effect-layer effect-b" aria-hidden="true"></div>
            <div class="narrative-caption"><h4 class="narrative-zh">{storyboards[work.title]?.[0]?.title}</h4><p class="narrative-ru" lang="ru">{storyboards[work.title]?.[0]?.ru}</p></div>
            <div class="narrative-arrows"><button type="button" class="story-prev" aria-label="上一幅情节画">←</button><button type="button" class="story-next" aria-label="下一幅情节画">→</button></div>
          </div>
          <div class="narrative-thumbs" style={`--count:${storyboards[work.title]?.length||1}`}>
            {storyboards[work.title]?.map((scene,k)=><button type="button" class:list={['narrative-thumb',{'is-selected':k===0}]} data-scene={k} aria-pressed={k===0?'true':'false'}><img src={scene.image} alt={scene.title} loading="lazy" width="1000" height="650" /><span>{String(k+1).padStart(2,'0')} · {scene.title}</span><small lang="ru">{scene.ru}</small></button>)}
          </div>
          {storyboards[work.title]?.some(x=>x.study)&&<p class="narrative-note">部分次要作品现使用风格统一的画面习作，情节画面尚待逐幅精绘；标题与情节依据原著编排。</p>}
        </section></div>)}
        <div class="scene-band"><img src={author.scene} alt={`${author.name}的后印象派风格文学场景`} loading="lazy"/><span>文学与绘画 · Литература и живопись / {author.number}</span></div>
      </article>)}
    </section>
  </main>
  <footer class="site-footer" id="about"><div><p class="closing">俄罗斯文学的流动画廊 · Галерея русской литературы</p><span>一座以中俄双语讲述文学、以绘画感受文学的数字图鉴。</span></div><div>章节按作家出生年份排序，并非严格的文学流派分期。<br/>主要作品按情节展示独立画面；部分其他作品仍使用构图习作，需要继续精绘。俄语论述为文学解读，非作品原文引文。<br/>© 2026 · 独立非商业艺术项目</div></footer>
  <script is:inline>
    (() => {
      const themes = [
        ['#eee4cd','#352c23','#766950','#b17b37','#cbbd9e'],
        ['#2c3738','#eee6d5','#c0b9a8','#cfaa6e','#586160'],
        ['#302725','#f1e5d2','#c5b3a4','#ca825c','#66504a'],
        ['#e9e5d7','#34413a','#627263','#849174','#bcc3ac'],
        ['#ede6e1','#4f5751','#837d82','#ab7f94','#cdbfc2']
      ];
      const cards=[...document.querySelectorAll('.art-card')];
      const dots=[...document.querySelectorAll('.dot')];
      const panels=[...document.querySelectorAll('.author-panel')];
      const counter=document.getElementById('current-index');
      const carousel=document.getElementById('carousel');
      let current=0;
      function select(index){
        current=Math.max(0,Math.min(cards.length-1,index));
        const vars=['--bg','--ink','--muted','--accent','--line'];
        vars.forEach((name,i)=>document.body.style.setProperty(name,themes[current][i]));
        document.querySelector('meta[name="theme-color"]').setAttribute('content',themes[current][0]);
        cards.forEach((card,i)=>{
          const offset=i-current,abs=Math.abs(offset);
          card.style.setProperty('--offset',offset);
          card.style.setProperty('--abs',abs);
          card.style.setProperty('--visibility',abs>2?0:1);
          card.style.pointerEvents=abs>2?'none':'auto';
          card.setAttribute('aria-current',String(i===current));
          card.tabIndex=abs>2?-1:0;
        });
        dots.forEach((dot,i)=>{dot.classList.toggle('active',i===current);dot.setAttribute('aria-pressed',String(i===current))});
        panels.forEach((panel,i)=>{panel.classList.toggle('active',i===current);panel.setAttribute('aria-hidden',String(i!==current))});
        counter.textContent=String(current+1).padStart(2,'0');
      }
      cards.forEach((card,i)=>card.addEventListener('click',()=>select(i)));
      dots.forEach((dot,i)=>dot.addEventListener('click',()=>select(i)));
      document.getElementById('prev').addEventListener('click',()=>select(current-1));
      document.getElementById('next').addEventListener('click',()=>select(current+1));
      carousel.addEventListener('keydown',ev=>{if(ev.key==='ArrowLeft'){ev.preventDefault();select(current-1);cards[current].focus()}if(ev.key==='ArrowRight'){ev.preventDefault();select(current+1);cards[current].focus()}});
      let downX=null;
      carousel.addEventListener('touchstart',e=>{downX=e.changedTouches[0].clientX},{passive:true});
      carousel.addEventListener('touchend',e=>{if(downX===null)return;const delta=e.changedTouches[0].clientX-downX;if(Math.abs(delta)>45)select(current+(delta<0?1:-1));downX=null},{passive:true});


      function getSceneEffect(story, index){
        const fx = {
          '叶甫盖尼·奥涅金':['glow sparkle','glow','snow fog','glow breeze','glow sparkle water'],
          '上尉的女儿':['snow','glow snow','snow embers smoke','snow fog','sparkle glow'],
          '死魂灵':['fog rain','fog','glow sparkle','fog rain','fog'],
          '罪与罚':['glow','glow rain','glow','snow fog','glow'],
          '战争与和平':['glow sparkle','sparkle glow','smoke embers','embers smoke','glow breeze'],
          '樱桃园':['petals glow','petals','petals breeze','fog petals','petals glow'],
          '彼得堡故事集':['fog rain','glow','fog','rain','fog glow'],
          '地下室手记':['glow','glow','glow'],
          '白痴':['glow','snow','glow'],
          '安娜·卡列尼娜':['sparkle glow','water fog','glow'],
          '复活':['glow','rain fog','glow'],
          '海鸥':['water glow','water sparkle','glow'],
          '万尼亚舅舅':['glow','breeze','glow'],
          '三姐妹':['fog','snow','glow']
        };
        return (fx[story] && fx[story][index]) || 'glow';
      }

      document.querySelectorAll('.narrative-gallery').forEach(gallery=>{
        const buttons=[...gallery.querySelectorAll('.narrative-thumb')];
        const image=gallery.querySelector('.narrative-image');
        const zh=gallery.querySelector('.narrative-zh');
        const ru=gallery.querySelector('.narrative-ru');
        const progress=gallery.querySelector('.story-progress');
        const stage=gallery.querySelector('.narrative-stage');
        let active=0;
        function show(n){
          if(!buttons.length)return;
          active=(n+buttons.length)%buttons.length;
          const button=buttons[active];
          const preview=button.querySelector('img');
          image.src=preview.getAttribute('src'); image.alt=preview.alt;
          image.classList.remove('refresh');void image.offsetWidth;image.classList.add('refresh');
          zh.textContent=button.querySelector('span').textContent.replace(/^\d+ · /,'');
          ru.textContent=button.querySelector('small').textContent;
          progress.textContent=String(active+1).padStart(2,'0')+' / '+String(buttons.length).padStart(2,'0');
          stage.dataset.effect = getSceneEffect(gallery.dataset.story, active);
          buttons.forEach((el,i)=>{el.classList.toggle('is-selected',i===active);el.setAttribute('aria-pressed',String(i===active));});
          button.scrollIntoView({block:'nearest',inline:'nearest',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});
        }
        buttons.forEach((btn,i)=>btn.addEventListener('click',()=>show(i)));
        gallery.querySelector('.story-prev').addEventListener('click',()=>show(active-1));
        gallery.querySelector('.story-next').addEventListener('click',()=>show(active+1));
        gallery.addEventListener('keydown',e=>{if(!e.target.closest('.narrative-thumb,.narrative-arrows'))return;if(e.key==='ArrowLeft'){e.preventDefault();show(active-1)}if(e.key==='ArrowRight'){e.preventDefault();show(active+1)}});
        show(0);
      });

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let carouselTimer = null;
      function clearCarouselAuto(){ if(carouselTimer){ clearInterval(carouselTimer); carouselTimer = null; } }
      function startCarouselAuto(){
        if(reduceMotion) return;
        clearCarouselAuto();
        carouselTimer = setInterval(()=>{
          const nextIndex = (current + 1) % cards.length;
          select(nextIndex);
        }, 6800);
      }
      ['mouseenter','focusin','touchstart'].forEach(evt=>carousel.addEventListener(evt, clearCarouselAuto, {passive:true}));
      ['mouseleave','focusout'].forEach(evt=>carousel.addEventListener(evt, startCarouselAuto));
      const galleryControllers = [];
      document.querySelectorAll('.narrative-gallery').forEach(gallery=>{
        const stage = gallery.querySelector('.narrative-stage');
        let timer = null;
        let isVisible = true;
        function pause(){ if(timer){ clearInterval(timer); timer=null; } gallery.dataset.auto='off'; }
        function resume(){ if(reduceMotion || !isVisible) return; pause(); gallery.dataset.auto='on'; timer=setInterval(()=>gallery.querySelector('.story-next')?.click(),5600); }
        ['mouseenter','focusin','touchstart'].forEach(evt=>gallery.addEventListener(evt,pause,{passive:true}));
        ['mouseleave','focusout'].forEach(evt=>gallery.addEventListener(evt,resume));
        galleryControllers.push({gallery,pause,resume,setVisible(v){isVisible=v; v?resume():pause();}});
        stage?.classList.add('is-playing');
      });
      const observer = !reduceMotion && 'IntersectionObserver' in window ? new IntersectionObserver(entries=>{
        entries.forEach(entry=>{
          const found = galleryControllers.find(x=>x.gallery===entry.target);
          if(found) found.setVisible(entry.isIntersecting && entry.intersectionRatio > 0.35);
        });
      },{threshold:[0,.35,.75]}) : null;
      galleryControllers.forEach(x=>{ observer ? observer.observe(x.gallery) : x.resume(); });
      document.addEventListener('visibilitychange',()=>{
        if(document.hidden){ clearCarouselAuto(); galleryControllers.forEach(x=>x.pause()); }
        else { startCarouselAuto(); galleryControllers.forEach(x=>x.resume()); }
      });

      select(0);
      startCarouselAuto();
    })();
  </script>
</body>
</html>
